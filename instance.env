# Source this before running any evergreen command for the TEAM instance:
#   source ~/Projects/evergreen-team/instance.env
#
# It points all state (DB, config, PIDs, logs) at a dedicated dir so this
# instance shares NOTHING with your personal ~/.evergreen instance, and moves
# the dashboard off the default port 8080 to avoid colliding with it.
export EVERGREEN_HOME="$HOME/.evergreen-team"
export EVERGREEN_DASHBOARD_PORT=8081
