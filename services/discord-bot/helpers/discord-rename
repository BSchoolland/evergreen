#!/usr/bin/env python3
"""Rename a Discord thread. Usage: discord-rename <thread_id> <new name...>"""
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

ENV_PATH = Path(__file__).resolve().parent.parent / ".env"


def token():
    for line in ENV_PATH.read_text().splitlines():
        if line.startswith("DISCORD_TOKEN="):
            return line.split("=", 1)[1].strip()
    sys.exit("DISCORD_TOKEN not found in " + str(ENV_PATH))


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__.strip())
    thread_id, name = sys.argv[1], " ".join(sys.argv[2:])[:100]
    req = urllib.request.Request(
        f"https://discord.com/api/v10/channels/{thread_id}",
        data=json.dumps({"name": name}).encode(),
        headers={
            "Authorization": "Bot " + token(),
            "Content-Type": "application/json",
            "User-Agent": "DiscordBot (evergreen-team, 2.0)",
        },
        method="PATCH",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            print(json.loads(r.read())["name"])
    except urllib.error.HTTPError as e:
        sys.exit(f"rename failed: HTTP {e.code}: {e.read().decode()[:200]}")


if __name__ == "__main__":
    main()
